# Core API production environment example.
# Copy to a protected file outside the repository, such as
# D:\AlgentraSecure\core-api.env, then replace required values.
# The production launcher sets APP_ENV=production for the service process.
APP_ENV=production

# Required: Supabase production project identity and secure cookies.
SUPABASE_PROJECT_REF=
COOKIE_SECURE=true

# Required: runtime role algentra_api only; never postgres, service_role, or migrator.
# Get host/port from Supabase Dashboard > Connect.
# Session-pooler username is usually algentra_api.<project-ref>.
# URL-encode special characters in the password and require TLS (sslmode=require).
DATABASE_URL=

# Required: replace with strong, unique values before starting the service.
APP_SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional: only when the Telegram signal EA will connect to this API.
EA_API_KEY=

# Required for automatic account provisioning after a settled QRIS payment.
# Configure the Midtrans notification URL as https://<api-origin>/api/payments/midtrans/notification.
MIDTRANS_SERVER_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_NOTIFICATION_URL=

# Required in production: use the exact same secret in the Vercel BFF environment.
BFF_HMAC_SECRET=

# Optional: exact browser origins allowed to use WebSocket endpoints, comma-separated.
WEBSOCKET_ALLOWED_ORIGINS=https://algentra.rnpproject.com

# Optional: Gemini signal parser. Leave the key empty to disable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=25
GEMINI_RETRY_ATTEMPTS=3
ENABLE_REGEX_FALLBACK=false

# Optional: customer-service chat; separate key from GEMINI_API_KEY.
GEMINI_CS_API_KEY=
GEMINI_CS_MODEL=gemini-3.8-flash
GEMINI_CS_TIMEOUT_SECONDS=60

# Optional: Telegram user integration. Set API_ID and API_HASH together.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional: only for transfer payments that require manual review. Set both together.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Optional: manual transfer instructions displayed for pending payment orders.
PAYMENT_MANUAL_INSTRUCTIONS=

# Optional: managed copier. Use the same strong secret in the Windows worker environment.
COPIER_WORKER_API_KEY=

# Optional: enable registration email and password reset. If used, fill all four
# SMTP identity/credential values (HOST, USERNAME, PASSWORD, FROM) together.
# Use a newly generated mail-provider app password; do not put it in source control.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_SMTP_STARTTLS=true

# Optional: HTTPS audio asset. Leave empty to hide the public music player.
PUBLIC_MUSIC_URL=

# Optional: public contact/social details; social values must be HTTPS URLs.
CONTACT_PERSON_NAME=
CONTACT_WHATSAPP=
CONTACT_EMAIL=
CONTACT_INSTAGRAM=
CONTACT_TELEGRAM=
CONTACT_TELEGRAM_ADMIN=
CONTACT_WEBSITE=
CONTACT_FACEBOOK=
CONTACT_LINKEDIN=
CONTACT_X=
CONTACT_YOUTUBE=
CONTACT_TIKTOK=
