@echo off
setlocal
set "ALGENTRA_SOURCE_ROOT=%~dp0"
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $sourceRoot=$env:ALGENTRA_SOURCE_ROOT; $bootstrapRoot=$null; $exitCode=1; try { if (-not (Test-Path -LiteralPath (Join-Path $sourceRoot 'infra\windows\launch-one-click.ps1') -PathType Leaf)) { $bootstrapRoot=Join-Path $env:TEMP ('algentra-bootstrap-' + [guid]::NewGuid().ToString('N')); New-Item -ItemType Directory -Path $bootstrapRoot -Force | Out-Null; $archive=Join-Path $bootstrapRoot 'source.zip'; Invoke-WebRequest -Uri 'https://github.com/rnpproject/algentraCapitalProject/archive/refs/heads/main.zip' -OutFile $archive; Expand-Archive -LiteralPath $archive -DestinationPath $bootstrapRoot -Force; & icacls.exe $bootstrapRoot /grant 'BUILTIN\Users:(OI)(CI)RX' /T /C | Out-Null; if ($LASTEXITCODE -ne 0) { throw 'Gagal memberi akses baca ke source bootstrap.' }; $sourceRoot=Join-Path $bootstrapRoot 'algentraCapitalProject-main'; if (-not (Test-Path -LiteralPath (Join-Path $sourceRoot 'infra\windows\launch-one-click.ps1') -PathType Leaf)) { throw 'Arsip repository belum menyertakan installer one-click. Jalankan file ini dari checkout repository atau gunakan versi setelah installer dipublikasikan.' } }; $launcher=Join-Path $sourceRoot 'infra\windows\launch-one-click.ps1'; $arguments=@('-NoLogo','-NoProfile','-ExecutionPolicy','Bypass','-File',[string][char]34 + $launcher + [char]34); $child=Start-Process -FilePath (Get-Command powershell.exe -ErrorAction Stop).Source -ArgumentList $arguments -Wait -PassThru; $exitCode=$child.ExitCode } finally { if ($bootstrapRoot -and (Test-Path -LiteralPath $bootstrapRoot -PathType Container)) { $tempPrefix=[IO.Path]::GetFullPath($env:TEMP).TrimEnd('\') + '\'; $bootstrapFull=[IO.Path]::GetFullPath($bootstrapRoot); if (-not $bootstrapFull.StartsWith($tempPrefix,[StringComparison]::OrdinalIgnoreCase)) { throw 'Jalur bootstrap sementara tidak aman untuk dibersihkan.' }; try { Remove-Item -LiteralPath $bootstrapFull -Recurse -Force } catch { Write-Warning ('Arsip bootstrap sementara tidak dapat dibersihkan: ' + $bootstrapFull) } } }; exit $exitCode"
if errorlevel 1 (
  echo Installer gagal. Catat pesan error pada jendela PowerShell.
  pause
)
