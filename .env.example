# Development template only. Copy to .env.local at the project root and replace
# required placeholders. Use a dedicated Supabase development project.
APP_ENV=development
APP_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
COOKIE_SECURE=false

# PostgreSQL connection from Supabase Dashboard > Connect (session pooler/direct).
# This is not the Project URL https://<project-ref>.supabase.co.
# Pooler username: algentra_api.<project-ref>; direct username: algentra_api.
# URL-encode reserved characters in the password; require sslmode=require.
DATABASE_URL=
SUPABASE_DEV_PROJECT_REF=

# Development-only PostgreSQL connection with role algentra_migrator.
# Pooler username: algentra_migrator.<project-ref>; direct username: algentra_migrator.
# Use only with run-db-migrations-dev.bat; never configure it on production.
MIGRATION_DATABASE_URL=

# Optional integrations. Leave a pair empty or fill both values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=25
GEMINI_RETRY_ATTEMPTS=3
ENABLE_REGEX_FALLBACK=false
GEMINI_CS_API_KEY=
GEMINI_CS_MODEL=gemini-3.8-flash
GEMINI_CS_TIMEOUT_SECONDS=60
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Optional: recipient account shown for manual transfers.
PAYMENT_BANK_NAME=
PAYMENT_NUMBER=
PAYMENT_NAME=
EA_API_KEY=
COPIER_WORKER_API_KEY=
# Internal local snapshot bridge secret; keep only in the Windows worker environment.
MASTER_PUBLISHER_TOKEN=
# Set MIDTRANS_SERVER_KEY to enable QRIS auto-provisioning; use sandbox outside production.
MIDTRANS_SERVER_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_NOTIFICATION_URL=
# Exact browser origins allowed to use the WebSocket endpoints, comma-separated.
# Local Next.js proxy origins:
WEBSOCKET_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Required on production API; match the server-only Vercel BFF secret.
BFF_HMAC_SECRET=

# Optional public contact details; social links must use HTTPS.
CONTACT_PERSON_NAME=
CONTACT_WHATSAPP=
CONTACT_EMAIL=
CONTACT_INSTAGRAM=
CONTACT_TELEGRAM=
CONTACT_TELEGRAM_ADMIN=
CONTACT_WEBSITE=
CONTACT_FACEBOOK=
CONTACT_LINKEDIN=
CONTACT_X=
CONTACT_YOUTUBE=
CONTACT_TIKTOK=

# Configure all four SMTP values together to enable email.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_SMTP_STARTTLS=true

# Optional public audio asset hosted on an HTTPS CDN/object storage.
# Leave empty to hide the music player; audio is never autoplayed.
PUBLIC_MUSIC_URL=

# BACKUP_DIR is read from the Windows process environment by the backup task;
# setting it here does not configure the scheduled task.
