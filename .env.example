# Development only: copy to .env.local and use a dedicated Supabase dev project.
# APP_ENV defaults to development; ADMIN_USERNAME, HTTP_ADDR and Gemini model also have defaults.
# Application/session secret and first admin password are generated and stored
# locally when missing. COOKIE_SECURE defaults off in development and on in production.

# Supabase Dashboard > Connect. Use direct/session pooler on port 5432,
# role algentra_api, URL-encoded password, and sslmode=require.
DATABASE_URL=

# Only needed when running run-db-migrations-dev.bat (role algentra_migrator).
MIGRATION_DATABASE_URL=

# EA API key is generated on first API start and shown under Dashboard > Settings.
# Gemini production settings are entered in the admin dashboard.
# Other integrations (Telegram, Midtrans, SMTP, copier) are optional.
